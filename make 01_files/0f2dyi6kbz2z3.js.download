o ${a}, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0) ${16.666666666666668}%)`,WebkitMask:`linear-gradient(to ${a}, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0) ${16.666666666666668}%)`,backdropFilter:i(0),WebkitBackdropFilter:i(0)}}),(0,l.jsx)("div",{className:n,style:{zIndex:2,mask:`linear-gradient(to ${a}, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 1) ${16.666666666666668}%, rgba(0, 0, 0, 0) ${33.333333333333336}%)`,WebkitMask:`linear-gradient(to ${a}, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 1) ${16.666666666666668}%, rgba(0, 0, 0, 0) ${33.333333333333336}%)`,backdropFilter:i(1),WebkitBackdropFilter:i(1)}}),Array.from({length:4}).map((t,s)=>(0,l.jsx)("div",{className:n,style:{zIndex:s+3,mask:`linear-gradient(to ${a}, rgba(0, 0, 0, 0) ${0+16.666666666666668*s}%, rgba(0, 0, 0, 1) ${0+(s+1)*16.666666666666668}%, rgba(0, 0, 0, 1) ${0+(s+2)*16.666666666666668}%, rgba(0, 0, 0, 0) ${0+(s+3)*16.666666666666668}%)`,WebkitMask:`linear-gradient(to ${a}, rgba(0, 0, 0, 0) ${0+16.666666666666668*s}%, rgba(0, 0, 0, 1) ${0+(s+1)*16.666666666666668}%, rgba(0, 0, 0, 1) ${0+(s+2)*16.666666666666668}%, rgba(0, 0, 0, 0) ${0+(s+3)*16.666666666666668}%)`,backdropFilter:i(s+2),WebkitBackdropFilter:i(s+2)}},`${e}-${s}`))]})})}function el({bgImage:e,bgVideo:t,bgPosition:a,title:s,subtitle:i,timeLeft:n}){let{t:r}=(0,c.useI18n)(),o=a?{objectPosition:a}:void 0;return(0,l.jsx)("div",{className:"flex w-full justify-center pt-[28px] max-[768px]:px-4 max-[768px]:pt-4",children:(0,l.jsxs)("div",{className:"relative flex w-full items-center justify-between overflow-hidden rounded-[20px] p-[28px] max-[768px]:flex-col max-[768px]:gap-6 max-[768px]:p-5",children:[(0,l.jsxs)("div",{className:"absolute inset-0 isolate overflow-hidden rounded-[20px] [clip-path:inset(0_round_20px)] [contain:paint]",children:[t?(0,l.jsx)("video",{className:"pointer-events-none h-full w-full select-none rounded-[20px] object-cover",style:o,src:t,poster:e??ee,autoPlay:!0,muted:!0,loop:!0,playsInline:!0,preload:"auto"}):(0,l.jsx)("img",{className:"pointer-events-none h-full w-full select-none rounded-[20px] object-cover",style:o,src:e??ee,alt:""}),(0,l.jsx)("div",{className:"absolute inset-0 bg-black/[0.08]"}),(0,l.jsx)("div",{className:"pointer-events-none absolute inset-0 z-0 hidden rounded-[20px] bg-black/[0.14] backdrop-blur-[12px] [transform:translateZ(0)] max-[768px]:block","aria-hidden":!0}),(0,l.jsx)("div",{className:"pointer-events-none absolute inset-0 max-[768px]:hidden",children:(0,l.jsx)(ei,{side:"left",tintGradient:"linear-gradient(to left, transparent, rgba(10, 15, 19, 0.25) 52.625%)"})})]}),(0,l.jsx)("div",{className:"relative z-[1] flex min-w-0 flex-1 items-center pl-[12px] max-[768px]:pl-0",children:(0,l.jsxs)("div",{className:"text-[22px] font-semibold leading-[28px] text-white",children:[(0,l.jsx)("p",{className:"max-[768px]:text-center",children:s}),(0,l.jsx)("p",{className:"max-[768px]:text-center",children:i})]})}),(0,l.jsx)("div",{className:"relative isolate z-[1] shrink-0 overflow-hidden rounded-[12px] bg-black/[0.08] backdrop-blur-[6px] [transform:translateZ(0)]",children:(0,l.jsxs)("div",{className:"relative z-[1] flex items-center",children:[(0,l.jsx)(et,{value:n.days,label:r("commercial_day_short"),isFirst:!0}),(0,l.jsx)(ea,{}),(0,l.jsx)(et,{value:n.hours,label:r("commercial_hour_short")}),(0,l.jsx)(ea,{}),(0,l.jsx)(et,{value:n.minutes,label:r("commercial_min_short")}),(0,l.jsx)(ea,{}),(0,l.jsx)(et,{value:n.seconds,label:r("commercial_sec_short"),isLast:!0})]})})]})})}function en(e){let{visible:t,bgImage:a,bgVideo:s,bgPosition:i,title:n,subtitle:r,timeLeft:o}=(0,Q.usePaywallBanner)();return t?(0,l.jsx)(el,{bgImage:a,bgVideo:s,bgPosition:i,title:n,subtitle:r,timeLeft:o}):null}function er(){return(er=Object.assign.bind()).apply(null,arguments)}let eo=function(e){return n.createElement("svg",er({xmlns:"http://www.w3.org/2000/svg",width:24,height:24,fill:"none",viewBox:"0 0 24 24"},e),s||(s=n.createElement("path",{fill:"currentColor",d:"M18.41 15.884a.4.4 0 0 0 .566 0l.566-.566a.4.4 0 0 0 0-.566l-6.648-6.647a.8.8 0 0 0-.28-.18.807.807 0 0 0-.85.18l-6.647 6.647a.4.4 0 0 0 0 .566l.566.566a.4.4 0 0 0 .565 0l6.081-6.081z"})))};var ec=e.i(402093);let ex=[{question:"如何获得更多积分？",answer:`<p>若当前积分不足，可通过以下方式获取：</p>
<ul>
<li>升级会员 —— 购买后立即生效，灵活补充。</li>
<li>积分充值 —— 付费会员均可购买，随时灵活补充。</li>
</ul>`},{question:"积分的有效期是多久？",answer:`<p><strong>月度订阅积分</strong></p>
<p>月度订阅所含积分仅在当前计费周期内有效，并将在下一个扣费日自动重置。当月未使用的积分不会结转至下个月。</p>
<p><strong>年度订阅积分</strong></p>
<p>年度订阅的积分按月发放。每月发放的积分仅在当月周期内有效，并将在下一个月度周期开始时自动重置。上月未使用的积分不会结转。</p>
<p><strong>充值积分</strong></p>
<p>充值积分自购买之日起 180 天内有效，到期后未使用的积分将失效。</p>`},{question:"账户内有多种积分时，会先扣哪一笔？",answer:"<p>当账户内同时存在多种积分时，系统会按到期时间由近及远的顺序自动扣减，优先消耗即将过期的积分，帮助你减少积分浪费。</p>"},{question:"我的订阅会自动续费吗？",answer:"<p>会的。你的订阅会在每个计费周期结束时自动续费，以确保你可以持续使用相关功能。你可以随时在账户设置中取消订阅，当前套餐仍会一直有效至本计费周期结束。</p>"},{question:"什么是无限生成？我的升级或续费会如何影响它？",answer:`<p>无限生成权益为您提供固定期限内的无限次低速生成，适用范围为 Agent 快速模式与生成器快速模式，包含推理与图像生成，不包含视频生成。具体的运行逻辑如下：</p>
<ul>
<li><strong>与账期独立：</strong>无限生成有其固定的时间主线（如 14 天、31 天或 90 天），独立于您的订阅账期。订阅的自动续费、取消或重新激活，均不会重置或延长该权益的原始到期时间。</li>
<li><strong>无限期内升级：</strong>若在未过期的同一无限生成期内升级会员，可同步解锁对应的高阶时长和范围，并按照最新权益继续享有。</li>
<li><strong>无限期后升级：</strong>无限生成为一次性特权。一旦到期，后续的升级、降级或重新订阅，均不会重复赠送或重新激活。</li>
<li><strong>公平守护：</strong>为保障算力集群体验，任何利用脚本、作弊等非人工活动可能会触发临时暂停以进行审核。核实为真实创作者后将立即恢复。</li>
</ul>`},{question:"快速生成与无限低速生成如何运作？",answer:`<p><strong>快速生成</strong></p>
<p>在快速模式下，每次生成都会消耗您的积分。订阅包含的快速积分将在每个计费周期开始时重置，无法累积至下月。为了最大化您的会员权益，建议您在当月结束前充分使用。</p>
<p>订阅内含积分会定期重置，但您单独购买的积分包不受计费周期影响。</p>
<p>您可以在订阅管理页面查看剩余的快速积分详情。</p>
<p><strong>无限低速生成</strong></p>
<p>无限低速生成模式仅面向特定档位会员提供，允许您在不消耗快速积分的情况下进行无限次生成。</p>
<p>在此模式下，您的任务请求将进入队列，并在系统 GPU 资源空闲时按序处理。因此，其生成时间通常比快速生成模式更长。具体的等待时长取决于您与其他用户相比使用该模式的频率。如果您使用该模式的频率较低，通常会获得更短的等待时间。您可以随时关闭无限低速模式，切换回快速生成模式以获得更快的速度。请注意，不同套餐的排队优先级不同：专业版 7000 积分档、专业版 20,000 积分档和旗舰版用户将被分配到不同的等待队列。</p>
<p>该功能仅限个人使用，严禁作弊、账号共享或转售行为。如检测到异常活动，访问权限可能会被临时暂停。</p>`},{question:"我可以升级我的套餐吗？",answer:'<p>一旦你有了有效的订阅，你可以随时通过支付差价来升级套餐。如果升级选项不可用，你可以先购买更高级别的套餐，购买成功后，请联系 <a href="mailto:support@lovart.art">support@lovart.art</a> 处理原方案的剩余权益。</p>'},{question:"会员&积分 退款规则",answer:`<p>会员与积分属于虚拟数字商品，开通后权益即时生效，故一经购买不支持任何理由的退款或转让。建议您在支付前确认所选内容。感谢理解🧡</p>`}],ed={en:[{question:"How do credits work?",answer:`<p>Credits are used to process your request and generate the final output, with usage depending on what you choose and how complex the task is.</p>
<p>For agent-based generation, credit consumption varies based on the tool or model selected and the level of detail in your request. For canvas generation, credits are determined by your settings, including image size and quality, desired style and detail, and any advanced parameters enabled.</p>
<p>In general, more complex tasks and more sophisticated settings require more credits.</p>`},{question:"Will credits expire?",answer:`<p><strong>Monthly Plan Credits</strong> from your monthly subscription are valid for the duration of your current billing cycle and will automatically reset on your next billing date. Unused credits do not roll over to the next month.</p>
<p><strong>Annual Plan Credits</strong> for annual subscriptions are distributed on a monthly basis. Each month's credits are valid only within that month's cycle and will automatically reset at the start of the next monthly cycle. Unused credits from the previous month will not carry over.</p>
<p><strong>Top-up Credits:</strong> Top-up credits are valid for 366 days from the date of purchase. Any unused credits will expire thereafter.</p>`},{question:"Can I purchase extra credits?",answer:"<p>If you need additional credits, you can upgrade your plan to increase your monthly limit or purchase credit packs to generate more content without changing your current subscription. Purchased credits are added instantly and can be used across all supported models.</p>"},{question:"Is my subscription automatically renewed?",answer:"<p>Yes. Your subscription renews automatically at the end of each billing cycle to maintain continuous access. You may cancel at any time in your account settings, and your plan will remain active through the end of the current billing period.</p>"},{question:"What is Unlimited Relax Generation, and how will my upgrade or renewal affect it?",answer:`<p>Unlimited Relax Generation provides you with unlimited slower-speed generations on designated models within a fixed timeframe. The specific operational rules are as follows:</p>
<ul>
<li><strong>Independent of Billing Cycles:</strong> Unlimited generation runs on its own fixed timeline (e.g., 31 or 180 days) and operates independently of your subscription billing cycle. Automatic renewals, cancellations, or re-activations of your subscription will not reset or extend the original expiration date of this benefit.</li>
<li><strong>Upgrades Within the Active Period:</strong> If you upgrade your membership within an active, unexpired unlimited generation period, you will unlock the corresponding higher-tier model parameters for the remaining days of that specific timeframe.</li>
<li><strong>Upgrades After Expiration:</strong> Unlimited generation is treated as a one-time privilege per account. Once expired, any subsequent upgrades, downgrades, or re-subscriptions will not reactivate or grant this benefit again.</li>
<li><strong>Unlimited Plan Dependency:</strong> For the 31-day or 180-day long-term unlimited plan, your underlying subscription must remain active. If you cancel or downgrade, your unlimited access will terminate at the end of the current billing cycle.</li>
<li><strong>Fair Use &amp; Protection:</strong> To ensure a stable and reliable experience across our GPU clusters, any automated scripts, botting, or non-human high-frequency activities may trigger a temporary suspension for review. Access will be restored immediately once verified as a real human creator.</li>
</ul>`},{question:"How do Fast Generation and Unlimited Relax Generation work?",answer:`<p><strong>Fast Generation</strong></p>
<p>In Fast Generation mode, each generation consumes credits from your balance. The fast credits included in your subscription reset at the start of each billing cycle and do not carry over to the next month. To maximize your subscription value, we recommend utilizing your full balance before the month ends.</p>
<p>Please note that while subscription credits reset periodically, any credit packs purchased separately are not affected by the billing cycle and will not expire.</p>
<p>You can monitor your usage and view your remaining fast credit details on the manage subscription page.</p>
<p><strong>Unlimited Relax Generation</strong></p>
<p>Unlimited Relax Generation mode is available exclusively to subscribers of specific plans, allowing for Unlimited Relax Generations without consuming your fast credits. In this mode, your requests are placed in a queue and processed as system GPU resources become available. Consequently, wait times are typically longer than in Fast Generation mode. Your specific wait time depends on your usage frequency relative to other users—those who use relax mode less frequently will generally experience shorter wait times.</p>
<p>You can turn off Unlimited Relax Generation at any time to switch back to Fast Generation for immediate results. Please note that queue priority varies by tier: Basic, Pro, and Ultimate users are assigned to different waiting queues.</p>
<p>This feature is for personal use only. Cheating, account sharing, or resale is strictly prohibited. Access may be temporarily suspended if any abnormal activity is detected.</p>`},{question:"How many devices can I use with one account?",answer:"<p>Lovart accounts are for individual use only. To prevent account sharing or abusive behavior that may excessively consume resources and affect platform stability, tasks can run simultaneously on up to 2 desktop Web, 1 mobile Web. For team or multi-user usage, please purchase the Team Plan.</p>"},{question:"Can I upgrade my plan?",answer:"<p>Once you have an active subscription, you can upgrade at any time by paying the price difference. If the upgrade option is unavailable, you may purchase the higher-tier plan first. After the purchase is successful, please contact support@lovart.ai to process the remaining benefits of your previous plan.</p>"}],zh:[{question:"积分是如何使用的？",answer:`<p>积分用于处理你的请求并生成最终结果，具体消耗取决于你选择的功能以及任务的复杂程度。</p>
<p>在基于 Agent 的生成中，积分消耗会根据所选工具或模型以及请求的详细程度而有所不同。对于画布（Canvas）生成，积分消耗由你的设置决定，包括图像尺寸与质量、期望的风格与细节程度，以及是否启用了高级参数。</p>
<p>总体来说，任务越复杂、设置越高级，所需的积分就越多。</p>`},{question:"积分会过期吗？",answer:`<p><strong>月度套餐积分：</strong>月度订阅的积分在当前计费周期内有效，并会在下一个计费日自动重置。未使用的积分不会滚动到下个月。</p>
<p><strong>年度套餐积分：</strong>年度订阅的积分按月分配。每月的积分仅在该月周期内有效，并会在下个月周期开始时自动重置。上月未使用的积分不会累计。</p>
<p><strong>充值积分：</strong>充值积分有效期为自购买之日起 366 天，之后未使用的积分将失效。</p>`},{question:"我可以购买额外的积分吗？",answer:"<p>如果你需要更多积分，可以升级套餐以提高每月的积分上限，或单独购买积分包，在不更改当前订阅的情况下生成更多内容。购买的积分会立即到账，并可在所有支持的模型中使用。</p>"},{question:"我的订阅会自动续费吗？",answer:"<p>会的。你的订阅会在每个计费周期结束时自动续费，以确保你可以持续使用相关功能。你可以随时在账户设置中取消订阅，当前套餐仍会一直有效至本计费周期结束。</p>"},{question:"什么是无限慢速生成？我的升级或续费会如何影响它？",answer:`<p>无限慢速生成权益为您提供固定期限内在套餐模型上的无限次慢速生成。具体的运行逻辑如下：</p>
<ul>
<li><strong>与账期独立：</strong> 无限生成有其固定的时间主线（如 31 天或 180 天），独立于您的订阅账期。订阅的自动续费、取消或重新激活，均不会重置或延长该权益的原始到期时间。</li>
<li><strong>无限期内升级：</strong> 若在未过期的同一无限生成期内升级会员，可同步解锁对应模型的高阶参数，并在剩余天数内继续享有。</li>
<li><strong>无限期后升级：</strong> 无限生成为一次性特权。一旦到期，后续的升级、降级或重新订阅，均不会重复赠送或重新激活。</li>
<li><strong>无限生成套餐联动：</strong> 31 天或 180 天长期无限套餐需保持订阅有效。若中途取消或降级订阅，无限访问将在当前方案到期时结束。</li>
<li><strong>公平守护：</strong> 为保障算力集群体验，任何利用脚本、作弊等非人工活动可能会触发临时暂停以进行审核。核实为真实创作者后将立即恢复。</li>
</ul>`},{question:"快速生成与无限低速生成如何运作？",answer:`<p><strong>快速生成</strong></p>
<p>在快速模式下，每次生成都会消耗您的积分。订阅包含的快速积分将在每个计费周期开始时重置，无法累积至下月。为了最大化您的会员权益，建议您在当月结束前充分使用。</p>
<p>订阅内含积分会定期重置，但您单独购买的积分包不受计费周期影响。</p>
<p>您可以在订阅管理页面查看剩余的快速积分详情。</p>
<p><strong>无限低速生成</strong></p>
<p>无限低速生成模式仅面向特定档位会员提供，允许您在不消耗快速积分的情况下进行无限次生成。</p>
<p>在此模式下，您的任务请求将进入队列，并在系统 GPU 资源空闲时按序处理。因此，其生成时间通常比快速生成模式更长。具体的等待时长取决于您与其他用户相比使用该模式的频率。如果您使用该模式的频率较低，通常会获得更短的等待时间。您可以随时关闭无限低速模式，切换回快速生成模式以获得更快的速度。请注意，不同套餐的排队优先级不同：Basic、Pro 和 Ultimate 用户将被分配到不同的等待队列。</p>
<p>该功能仅限个人使用，严禁作弊、账号共享或转售行为。如检测到异常活动，访问权限可能会被临时暂停。</p>`},{question:"一个账户可以在多少台设备上使用？",answer:"<p>Lovart 账户仅供个人使用。为防止账户共享或可能过度消耗资源并影响平台稳定性的滥用行为，任务最多可同时在 2 个桌面网页端和 1 个移动网页端上运行。如需团队或多用户使用，请购买团队版。</p>"},{question:"我可以升级我的套餐吗？",answer:"<p>一旦你有了有效的订阅，你可以随时通过支付差价来升级套餐。如果升级选项不可用，你可以先购买更高级别的套餐。购买成功后，请联系 support@lovart.ai，我们将为你处理原计划的剩余权益。</p>"}],"zh-TW":[{question:"積分是如何運作的？",answer:`<p>積分用於處理您的請求並生成最終輸出，使用量取決於您選擇的內容和任務的複雜程度。</p>
<p>對於基於智能體的生成，積分消耗會根據所選工具或模型以及請求的詳細程度而有所不同。對於畫布生成，積分由您的設定決定，包括圖像大小和品質、所需的風格和細節，以及啟用的任何進階參數。</p>
<p>通常，更複雜的任務和更精細的設定需要更多積分。</p>`},{question:"積分會過期嗎？",answer:`<p><strong>月度方案積分：</strong>月度訂閱的積分在當前計費週期內有效，並會在下一個計費日自動重置。未使用的積分不會滾動到下個月。</p>
<p><strong>年度方案積分：</strong>年度訂閱的積分按月分配。每月的積分僅在該月週期內有效，並會在下個月週期開始時自動重置。上月未使用的積分不會累計。</p>
<p><strong>儲值積分：</strong>儲值積分自購買日起 366 天內有效，逾期未使用的積分將失效。</p>`},{question:"我可以購買額外積分嗎？",answer:"<p>如果您需要額外積分，您可以升級方案以增加每月限額，或購買積分包來生成更多內容，而無需更改當前訂閱。購買的積分會立即添加，可在所有支援的模型中使用。</p>"},{question:"我的訂閱會自動續費嗎？",answer:"<p>是的。您的訂閱會在每個計費週期結束時自動續費，以保持持續存取。您可以隨時在帳戶設定中取消訂閱，您的方案將在當前計費週期結束前保持有效。</p>"},{question:"什麼是無限慢速生成？我的升級或續費會如何影響它？",answer:`<p>無限慢速生成權益為您提供固定期限內在方案模型上的無限次慢速生成。具體的運行邏輯如下：</p>
<ul>
<li><strong>與帳期獨立：</strong> 無限生成有其固定的時間主線（如 31 天或 180 天），獨立於您的訂閱帳期。訂閱的自動續費、取消或重新啟用，均不會重置或延長該權益的原始到期時間。</li>
<li><strong>無限期內升級：</strong> 若在未過期的同一無限生成期內升級會員，可同步解鎖對應模型的高階參數，並在剩餘天數內繼續享有。</li>
<li><strong>無限期後升級：</strong> 無限生成為一次性特權。一旦到期，後續的升級、降級或重新訂閱，均不會重複贈送或重新啟用。</li>
<li><strong>無限生成方案聯動：</strong> 31 天或 180 天長期無限方案需保持訂閱有效。若中途取消或降級訂閱，無限訪問將在當前方案到期時結束。</li>
<li><strong>公平守護：</strong> 為保障算力集群體驗，任何利用腳本、作弊等非人工活動可能會觸發臨時暫停以進行審核。核實為真實創作者後將立即恢復。</li>
</ul>`},{question:"快速生成與無限低速生成如何運作？",answer:`<p><strong>快速生成</strong></p>
<p>在快速模式下，每次生成都會消耗您的積分。訂閱包含的快速積分將在每個計費週期開始時重置，無法累積至下月。為了最大化您的會員權益，建議您在當月結束前充分使用。</p>
<p>訂閱內含積分會定期重置，但您單獨購買的積分包不受計費週期影響。</p>
<p>您可以在訂閱管理頁面查看剩餘的快速積分詳情。</p>
<p><strong>無限低速生成</strong></p>
<p>無限低速生成模式僅面向特定檔位會員提供，允許您在不消耗快速積分的情況下進行無限次生成。</p>
<p>在此模式下，您的任務請求將進入佇列，並在系統 GPU 資源空閒時按序處理。因此，其生成時間通常比快速生成模式更長。具體的等待時長取決於您與其他用戶相比使用該模式的頻率。如果您使用該模式的頻率較低，通常會獲得更短的等待時間。您可以隨時關閉無限低速模式，切換回快速生成模式以獲得更快的速度。請注意，不同方案的排隊優先級不同：Basic、Pro 和 Ultimate 用戶將被分配到不同的等待佇列。</p>
<p>此功能僅供個人使用，嚴禁作弊、帳戶共享或轉售行為。如偵測到異常活動，存取可能會被臨時暫停。</p>`},{question:"一個帳戶可以在多少台設備上使用？",answer:"<p>Lovart 帳戶僅供個人使用。為防止帳戶共享或可能過度消耗資源並影響平台穩定性的濫用行為，任務最多可同時在 2 個桌面網頁端和 1 個行動網頁端上運行。如需團隊或多用戶使用，請購買團隊版。</p>"},{question:"我可以升級我的方案嗎？",answer:"<p>只要你擁有有效的訂閱，即可隨時支付差價升級方案。如果升級選項無法使用，你可以先購買更高等級的方案。購買成功後，請聯繫 support@lovart.ai，我們將為你處理原方案的剩餘權益。</p>"}],ja:[{question:"クレジットはどのように機能しますか？",answer:`<p>クレジットはリクエストの処理と最終出力の生成に使用され、使用量は選択した内容とタスクの複雑さによって異なります。</p>
<p>エージェントベースの生成では、選択したツールやモデル、リクエストの詳細レベルに応じてクレジット消費が変わります。キャンバス生成では、画像サイズと品質、希望のスタイルと詳細度、有効にした高度なパラメータなど、設定によってクレジットが決まります。</p>
<p>一般的に、より複雑なタスクとより高度な設定には、より多くのクレジットが必要です。</p>`},{question:"クレジットは期限切れになりますか？",answer:`<p><strong>月額プランのクレジット：</strong>月額サブスクリプションのクレジットは現在の請求サイクル中有効で、次の請求日に自動的にリセットされます。未使用のクレジットは翌月に繰り越されません。</p>
<p><strong>年間プランのクレジット：</strong>年間サブスクリプションのクレジットは月ごとに配布されます。毎月のクレジットはその月のサイクル内でのみ有効で、次の月のサイクル開始時に自動的にリセットされます。前月の未使用クレジットは繰り越されません。</p>
<p><strong>追加購入クレジット：</strong>追加購入クレジットの有効期限は購入日から366日間です。期限後、未使用のクレジットは失効します。</p>`},{question:"追加クレジットを購入できますか？",answer:"<p>追加クレジットが必要な場合は、プランをアップグレードして月間制限を増やすか、現在のサブスクリプションを変更せずにクレジットパックを購入してより多くのコンテンツを生成できます。購入したクレジットは即座に追加され、サポートされているすべてのモデルで使用できます。</p>"},{question:"サブスクリプションは自動更新されますか？",answer:"<p>はい。サブスクリプションは継続的なアクセスを維持するために、各請求サイクルの終了時に自動的に更新されます。アカウント設定からいつでもキャンセルでき、プランは現在の請求期間の終了まで有効です。</p>"},{question:"無限慢速生成とは何ですか？アップグレードや更新によってどう影響を受けますか？",answer:`<p>無限慢速生成特典は、指定された固定期間内に対象モデルでの無制限の低速生成を提供するものです。具体的な仕組みは以下の通りです：</p>
<ul>
<li><strong>契約プラン（帳期）からの独立：</strong> 無制限特典には独自の固定期間（31日間または180日間）があり、サブスクリプションの請求サイクル（帳期）とは独立してカウントされます。サブスクリプションの自動更新、解約、または再開手続きを行っても、本特典の当初の有効期限がリセットされたり延長されたりすることはありません。</li>
<li><strong>有効期間内のアップグレード：</strong> 特典の有効期限が切れる前に上位プランへアップグレードした場合、該当モデルの上位パラメータ（高階パラメータ）が無条件で解放され、残りの日数分引き続きご利用いただけます。</li>
<li><strong>有効期間終了後のアップグレード：</strong> 無制限特典はアカウントにつき1回限りの限定特典です。一度期限が切れると、その後のアップグレード、ダウングレード、または再購読（再サブスクリプション）によって、本特典が再度付与されたり再アクティベーションされたりすることはありません。</li>
<li><strong>無制限生成プランの連動ルール：</strong> 31日間または180日間の長期無制限プランでは、ベースとなるサブスクリプションが有効である必要があります。途中で解約またはダウングレードされた場合、無制限アクセスは現在の契約期間の終了をもって停止します。</li>
<li><strong>フェアフューズ（公平な利用）保護：</strong> GPUクラスタ全体の快適な利用環境を維持するため、スクリプトの利用、不正行為、その他自動化された非人間的な高頻度アクセスが検知された場合、確認のためアクセスを一時停止することがあります。人間のクリエイターによる正当な利用であると確認され次第、ただちに権限を復旧いたします。</li>
</ul>`},{question:"高速生成と無制限リラックス生成の仕組みについて",answer:`<p><strong>高速生成</strong></p>
<p>高速生成モードでは、生成ごとにクレジットが消費されます。サブスクリプションに含まれるファストクレジットは、各請求サイクルの開始時にリセットされ、翌月へ繰り越すことはできません。特典を最大限に活用するために、月末までにクレジットを使い切ることをお勧めします。</p>
<p>なお、サブスクリプション特典のクレジットは定期的にリセットされますが、別途購入されたクレジットパックは請求サイクルの影響を受けず、有効期限もありません。クレジットの残り詳細は、サブスクリプション管理ページでご確認いただけます。</p>
<p><strong>無制限リラックス生成</strong></p>
<p>無制限リラックス生成モードは、特定のプランをご契約のお客様限定の機能で、高速生成クレジットを消費せずに無制限で生成を行うことができます。このモードでは、リクエストはキュー（待ち行列）に追加され、システムのGPUリソースが空き次第、順次処理されます。そのため、待ち時間は通常、高速生成モードよりも長くなります。具体的な待ち時間は他のユーザーとの比較における利用頻度によって変動し、リラックスモードの利用頻度が低いユーザーほど、優先的に処理（待ち時間の短縮）される仕組みとなっています。</p>
<p>無制限リラックス生成はいつでもオフにすることができ、高速生成モードに切り替えて即座に結果を得ることが可能です。なお、キューの優先順位はティア（プラン）ごとに異なり、Basic、Pro、Ultimateの各ユーザーは、それぞれ異なる待機列に割り当てられます。</p>
<p>本機能は個人利用のみを目的としています。不正行為、アカウントの共有、または転売は固く禁止されています。異常なアクティビティが検出された場合、アクセスが一時的に停止されることがあります。</p>`},{question:"1つのアカウントで何台のデバイスを使用できますか？",answer:"<p>Lovartアカウントは個人利用専用です。アカウント共有や、リソースを過剰に消費してプラットフォームの安定性に影響を与える可能性のある不正行為を防止するため、タスクは同時にデスクトップWeb 2台とモバイルWeb 1台で実行できます。チームまたは複数ユーザーでの使用には、チームプランをご購入ください。</p>"},{question:"プランをアップグレードできますか？",answer:"<p>有効なサブスクリプションをお持ちの場合、差額をお支払いいただくことで、いつでもプランをアップグレードできます。アップグレードオプションが利用できない場合は、先に上位プランをご購入ください。購入完了後、support@lovart.ai までご連絡いただければ、以前のプランの残りの特典について対応いたします。</p>"}],ko:[{question:"크레딧은 어떻게 사용되나요?",answer:`<p>크레딧은 요청을 처리하고 최종 결과물을 생성하는 데 사용되며, 사용량은 선택한 내용과 작업의 복잡도에 따라 달라집니다.</p>
<p>에이전트 기반 생성에서는 선택한 도구나 모델, 그리고 요청의 상세 수준에 따라 크레딧 소비량이 달라집니다. 캔버스 생성에서는 이미지 크기와 품질, 원하는 스타일과 디테일, 활성화한 고급 파라미터 등 설정에 따라 크레딧이 결정됩니다.</p>
<p>일반적으로 작업이 복잡하고 설정이 정교할수록 더 많은 크레딧이 필요합니다.</p>`},{question:"크레딧은 만료되나요?",answer:`<p><strong>월간 플랜 크레딧:</strong> 월간 구독에 포함된 크레딧은 현재 결제 주기 동안 유효하며, 다음 결제일에 자동으로 초기화됩니다. 사용하지 않은 크레딧은 다음 달로 이월되지 않습니다.</p>
<p><strong>연간 플랜 크레딧:</strong> 연간 구독의 크레딧은 매월 지급됩니다. 매월 지급된 크레딧은 해당 월 주기 내에서만 유효하며, 다음 월 주기가 시작될 때 자동으로 초기화됩니다. 전월의 미사용 크레딧은 이월되지 않습니다.</p>
<p><strong>충전 크레딧:</strong> 충전 크레딧은 구매일로부터 366일간 유효하며, 그 이후 사용하지 않은 크레딧은 소멸됩니다.</p>`},{question:"추가 크레딧을 구매할 수 있나요?",answer:"<p>추가 크레딧이 필요한 경우, 플랜을 업그레이드하여 월 한도를 늘리거나, 현재 구독을 변경하지 않고 크레딧 팩을 구매하여 더 많은 콘텐츠를 생성할 수 있습니다. 구매한 크레딧은 즉시 지급되며, 지원되는 모든 모델에서 사용할 수 있습니다.</p>"},{question:"구독은 자동으로 갱신되나요?",answer:"<p>네. 구독은 서비스를 계속 이용할 수 있도록 각 결제 주기가 끝날 때 자동으로 갱신됩니다. 계정 설정에서 언제든지 해지할 수 있으며, 해지 후에도 플랜은 현재 결제 기간이 끝날 때까지 유효합니다.</p>"},{question:"무제한 릴랙스 생성이란 무엇이며, 업그레이드나 갱신은 이 혜택에 어떤 영향을 주나요?",answer:`<p>무제한 릴랙스 생성은 정해진 기간 동안 지정된 모델에서 저속 생성을 무제한으로 이용할 수 있는 혜택입니다. 구체적인 운영 규칙은 다음과 같습니다.</p>
<ul>
<li><strong>결제 주기와 독립:</strong> 무제한 생성은 구독 결제 주기와 무관하게 자체적인 고정 기간(예: 31일 또는 180일)으로 운영됩니다. 구독의 자동 갱신, 해지, 재활성화는 이 혜택의 최초 만료일을 초기화하거나 연장하지 않습니다.</li>
<li><strong>유효 기간 내 업그레이드:</strong> 만료되지 않은 무제한 생성 기간 중에 멤버십을 업그레이드하면, 해당 기간의 남은 일수 동안 상위 등급 모델의 파라미터를 이용할 수 있습니다.</li>
<li><strong>만료 후 업그레이드:</strong> 무제한 생성은 계정당 1회에 한해 제공되는 혜택입니다. 한 번 만료되면 이후의 업그레이드, 다운그레이드, 재구독으로는 이 혜택이 다시 제공되거나 재활성화되지 않습니다.</li>
<li><strong>무제한 생성 플랜 연동:</strong> 31일 또는 180일 장기 무제한 플랜은 기반 구독이 유효한 상태로 유지되어야 합니다. 중도에 해지하거나 다운그레이드하면 무제한 이용 권한은 현재 결제 주기가 끝날 때 종료됩니다.</li>
<li><strong>공정 이용 보호:</strong> GPU 클러스터 전반에서 안정적이고 신뢰할 수 있는 이용 환경을 유지하기 위해, 자동화 스크립트, 봇 이용, 그 밖의 비인간적 고빈도 활동이 감지되면 확인을 위해 이용이 일시 중지될 수 있습니다. 실제 창작자임이 확인되는 즉시 이용이 복구됩니다.</li>
</ul>`},{question:"고속 생성과 무제한 릴랙스 생성은 어떻게 작동하나요?",answer:`<p><strong>고속 생성</strong></p>
<p>고속 생성 모드에서는 생성할 때마다 보유 크레딧이 차감됩니다. 구독에 포함된 고속 크레딧은 각 결제 주기가 시작될 때 초기화되며 다음 달로 이월되지 않습니다. 구독 혜택을 최대한 활용하시려면 해당 월이 끝나기 전에 보유 크레딧을 모두 사용하시는 것을 권장합니다.</p>
<p>구독에 포함된 크레딧은 주기적으로 초기화되지만, 별도로 구매한 크레딧 팩은 결제 주기의 영향을 받지 않으며 만료되지 않습니다.</p>
<p>구독 관리 페이지에서 사용량과 남은 고속 크레딧의 상세 내역을 확인할 수 있습니다.</p>
<p><strong>무제한 릴랙스 생성</strong></p>
<p>무제한 릴랙스 생성 모드는 특정 플랜 구독자에게만 제공되며, 고속 크레딧을 소비하지 않고 무제한으로 생성할 수 있습니다. 이 모드에서는 요청이 대기열에 추가되어 시스템 GPU 자원이 확보되는 순서대로 처리됩니다. 따라서 대기 시간은 일반적으로 고속 생성 모드보다 길어집니다. 구체적인 대기 시간은 다른 사용자와 비교한 이용 빈도에 따라 달라지며, 릴랙스 모드를 덜 자주 사용하는 사용자는 대체로 더 짧은 대기 시간을 경험합니다.</p>
<p>무제한 릴랙스 생성은 언제든지 끌 수 있으며, 고속 생성으로 전환하여 즉시 결과를 받을 수 있습니다. 대기열 우선순위는 등급에 따라 다르며, Basic, Pro, Ultimate 사용자는 각각 다른 대기열에 배정됩니다.</p>
<p>본 기능은 개인 이용 전용입니다. 부정 이용, 계정 공유, 재판매는 엄격히 금지됩니다. 비정상적인 활동이 감지되면 이용이 일시적으로 중지될 수 있습니다.</p>`},{question:"하나의 계정으로 몇 대의 기기에서 사용할 수 있나요?",answer:"<p>Lovart 계정은 개인 이용 전용입니다. 계정 공유, 또는 자원을 과도하게 소모하여 플랫폼 안정성에 영향을 줄 수 있는 남용 행위를 방지하기 위해, 작업은 데스크톱 Web 최대 2대와 모바일 Web 1대에서 동시에 실행할 수 있습니다. 팀 또는 다중 사용자 이용을 원하시는 경우 Team Plan을 구매해 주십시오.</p>"},{question:"플랜을 업그레이드할 수 있나요?",answer:"<p>유효한 구독이 있다면 차액을 결제하여 언제든지 플랜을 업그레이드할 수 있습니다. 업그레이드 옵션을 사용할 수 없는 경우, 먼저 상위 플랜을 구매해 주세요. 구매 완료 후 support@lovart.ai로 문의하시면 기존 플랜의 남은 혜택을 처리해 드립니다.</p>"}]},eu={en:"Frequently asked questions",zh:"常见问题","zh-TW":"常見問題",ja:"よくある質問",ko:"자주 묻는 질문"};function em(){let{t:e,lang:t}=(0,c.useI18n)(),{isFromPricing:a}=(0,S.useSkuContext)(),s=(0,ec.useSkuState)("skuTranslations")?.faq,[i,r]=(0,n.useState)(null),x=o.isCN?s?.length?s:ex:ed[t]||ed.en,d=o.isCN?eu.zh:eu[t]||eu.en;return(0,l.jsx)("section",{className:(0,y.cn)("relative mt-[120px] w-full overflow-hidden pb-[120px]",a?"bg-bg-base-default":""),children:(0,l.jsxs)("div",{className:"mx-auto w-full max-w-[1600px]",children:[(0,l.jsx)("div",{className:"pb-[60px] pt-0 text-center",children:(0,l.jsx)("h2",{className:(0,y.cn)("font-serif-display text-lo-text-default text-balance text-center text-[30px] leading-[1.25] md:text-[40px]",a?"xl:text-[56px]":""),children:d})}),(0,l.jsxs)("div",{className:"mx-auto max-w-[768px]",children:[(0,l.jsx)("div",{className:"flex flex-col",children:x.map((e,t)=>{let a=`item-${t}`,s=i===a;return(0,l.jsxs)("div",{className:"border-lo-border-neutral-l2 border-b",children:[(0,l.jsxs)("button",{onClick:()=>r(s?null:a),className:"group/trigger flex w-full cursor-pointer items-center justify-between py-5",children:[(0,l.jsx)("h4",{className:"text-lo-text-default w-[calc(100%-40px)] text-left font-sans text-[16px] font-medium leading-[1.4] md:text-[20px]",children:e.question}),(0,l.jsx)("div",{className:(0,y.cn)("flex h-[24px] w-[24px] shrink-0 items-center justify-center transition-transform duration-300",!s&&"rotate-180"),children:(0,l.js