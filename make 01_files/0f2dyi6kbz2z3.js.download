    .${U} {
      display: inline-flex;
      /* 不用 baseline：货币符号要与数字「上对齐」而非落在同一基线上（交付稿 .digit.yen 是 align-self:flex-start）。
         stretch 下各字撑满容器高度，prefix 单独 flex-start 即可顶到最高字的行盒顶部 */
      align-items: stretch;
      font-variant-numeric: tabular-nums;
      /* 交付稿在数字容器上开 3D 透视，rotateX 才有纵深；缺了它翻入会退化成扁平缩放 */
      perspective: 300px;
    }
    .${U} .${O}[data-prefix='true'] {
      align-self: flex-start;
    }
    /* 数字显式参与基线对齐：flex 容器的基线取自「首个参与基线对齐的 item」，
       都不参与时才回落到首个 item。\xa5 是 flex-start（不参与），若数字也不参与，
       外层 items-baseline 就会拿 \xa5 的基线去对齐，主价会整体错位十几 px */
    .${U} .${O}:not([data-prefix]) {
      align-self: baseline;
    }
    .${U} .${O} {
      display: inline-block;
      white-space: pre;
      transform-origin: 50% 80%;
      will-change: transform, opacity, filter;
    }
    .${U}[data-animating='true'] .${O} {
      animation: ${U}-in 540ms cubic-bezier(.29, 1.17, .64, 1) both;
    }
    @keyframes ${U}-in {
      0% { opacity: 0; filter: blur(5px); transform: translateY(12px) rotateX(-72deg) scale(.86); }
      68% { opacity: 1; filter: blur(0); transform: translateY(-.75px) rotateX(2deg) scale(1.006); }
      100% { opacity: 1; filter: blur(0); transform: translateY(0) rotateX(0) scale(1); }
    }
    @media (prefers-reduced-motion: reduce) {
      .${U} .${O} { animation: none !important; }
    }
