@keyframes lo-memory-example-out {
  from { opacity: 1; transform: translateY(0); }
  to   { opacity: 0; transform: translateY(-50%); }
}
@keyframes lo-memory-example-in {
  from { opacity: 0; transform: translateY(50%); }
  to   { opacity: 1; transform: translateY(0); }
}
.lo-memory-example-out {
  animation: lo-memory-example-out 500ms ${e3} both;
}
.lo-memory-example-in {
  animation: lo-memory-example-in 500ms ${e3} both;
}
@media (prefers-reduced-motion: reduce) {
  .lo-memory-example-in { animation: none; }
  /* 离场那条得真的消失，否则跟新那条叠成两行 */
  .lo-memory-example-out { animation: none; opacity: 0; }
}`;function e8({examples:e,className:t}){!function(){if("u"<typeof document||document.getElementById(e7))return;let e=document.createElement("style");e.id=e7,e.textContent=e6,document.head.appendChild(e)}();let[{index:l,leaving:r},a]=(0,s.useState)({index:0,leaving:-1}),o=e.length;(0,s.useEffect)(()=>{if(o<=1)return;let e=setTimeout(()=>a(e=>({index:(e.index+1)%o,leaving:e.index})),5e3);return()=>clearTimeout(e)},[o,l]),(0,s.useEffect)(()=>{if(r<0)return;let e=setTimeout(()=>a(e=>({...e,leaving:-1})),500);return()=>clearTimeout(e)},[r]);let i=e[l];if(!i)return null;let c=r>=0?e[r]:void 0,d=c&&c.length>i.length?c:i;return(0,n.jsxs)("span",{className:(0,j.cn)("relative inline-block h-[25px] overflow-hidden align-bottom",t),children:[(0,n.jsx)("span",{className:"invisible block whitespace-nowrap","aria-hidden":!0,children:d}),void 0!==c&&(0,n.jsx)("span",{className:"lo-memory-example-out absolute top-0 left-0 block whitespace-nowrap",children:c}),(0,n.jsx)("span",{className:(0,j.cn)("absolute top-0 left-0 block whitespace-nowrap",r>=0&&"lo-memory-example-in"),children:i},l)]})}let e9={kind:"global"},te=(0,s.lazy)(()=>e.A(305241).then(e=>({default:e.MemoryComposerInput}))),tt=(0,s.lazy)(()=>e.A(830838).then(e=>({default:e.MemoryComposerVoice}))),tl=`
@keyframes lo-memory-composer-rise {
  from { transform: translateY(16px) scale(0.96); opacity: 0; }
  to   { transform: translateY(0) scale(1); opacity: 1; }
}
@keyframes lo-memory-composer-sink {
  from { transform: translateY(0) scale(1); opacity: 1; }
  to   { transform: translateY(16px) scale(0.96); opacity: 0; }
}
@keyframes lo-memory-composer-fade {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.lo-memory-composer-rise {
  transform-origin: center bottom;
  /* backwards 而不是 both：首帧就要吃到起始态，但播完别把 transform 残留在壳上
     —— 那会给 Lexical 输入区留一个合成层，也会把内部 fixed 子层的包含块改成这个壳 */
  animation: lo-memory-composer-rise 260ms cubic-bezier(0.32, 0.72, 0, 1) backwards;
}
/* forwards：播完停在终态，别在卸载前的最后一帧闪回原大小 */
.lo-memory-composer-sink {
  transform-origin: center bottom;
  animation: lo-memory-composer-sink 180ms cubic-bezier(0.32, 0.72, 0, 1) forwards;
}
.lo-memory-composer-fade {
  animation: lo-memory-composer-fade 150ms ease-out backwards;
}
@media (prefers-reduced-motion: reduce) {
  .lo-memory-composer-rise,
  .lo-memory-composer-sink,
  .lo-memory-composer-fade {
    animation: none;
  }
