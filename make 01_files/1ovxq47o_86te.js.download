@keyframes lo-persona-mascot-frames {
  from { background-position: 0 0; }
  to   { background-position: 100% 0; }
}
.lo-persona-mascot-frame {
  background-repeat: no-repeat;
  /* N 帧 → 背景宽 N\xd7100%；帧窗自身 114px，所以一屏正好一帧 */
  background-size: calc(var(--lo-mascot-frames) * 100%) 100%;
  background-position: 0 0;
}
/* steps(N, jump-none) 在 0% → 100% 之间正好落 N 个整帧位，每帧 250ms */
.lo-persona-mascot:hover .lo-persona-mascot-frame {
  animation: lo-persona-mascot-frames calc(var(--lo-mascot-frames) * 250ms)
    steps(var(--lo-mascot-frames), jump-none) infinite;
}
@media (prefers-reduced-motion: reduce) {
  .lo-persona-mascot:hover .lo-persona-mascot-frame { animation: none; }
