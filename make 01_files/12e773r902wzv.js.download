(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,676968,e=>{"use strict";let t,l,n;var a,r,s,i,c,o,d,u,h,p,m,x,f,g,_,v,b,j,w,y,N,E,A,C,k,M,I,T,O,z,S=e.i(441164),D=e.i(316182),R=e.i(278504),H=e.i(227901),P=e.i(965990),L=e.i(273024),G=e.i(767678),K=e.i(715074),B=e.i(893963),U=e.i(712173),V=e.i(82033),q=e.i(658544);let F={frequency:"once",time:"08:00"},W=(e,t="09:00")=>({frequency:"weekly",weekday:e,time:t}),$=e=>({frequency:"daily",time:e}),Y=[{id:"inspiration_radar",iconKey:"light-bulb-glow",recurrence:$("09:00")},{id:"occasion_prep",iconKey:"tree",recurrence:$("09:00")},{id:"competitor_research",iconKey:"document",recurrence:W("MO")}],Z=[...Y,{id:"marketing_calendar",iconKey:"sweets",recurrence:W("TU")},{id:"social_topics",iconKey:"radar",recurrence:W("WE")},{id:"daily_post",iconKey:"lightning",recurrence:$("09:00")},{id:"moodboard",iconKey:"light-bulb-glow",recurrence:W("TH")},{id:"drama_radar",iconKey:"cryptopunk",recurrence:W("MO")},{id:"listing",iconKey:"cloth",recurrence:F},{id:"thumbnail",iconKey:"image",recurrence:F},{id:"sale_assets",iconKey:"rocket",recurrence:F},{id:"upscale",iconKey:"brightness",recurrence:F},{id:"localize",iconKey:"earth",recurrence:F},{id:"storyboard",iconKey:"video",recurrence:F},{id:"character",iconKey:"character",recurrence:F},{id:"reference",iconKey:"surfing",recurrence:F}],Q=[{id:"cn_marketing_calendar",iconKey:"sweets",recurrence:W("TU"),title:"营销日历",description:"每周发现未来一周适合品牌参与的营销节点，推荐最多 2 个内容方向",prompt:`我负责一个香氛品牌的中国市场运营，主要通过小红书推广香氛蜡烛，内容以居家氛围、生活方式和节日送礼为主，目标用户是关注居家体验和生活品质的消费者。
请调研中国市场未来一周内适合品牌参与的节日、节气、电商大促节点或热点事件，优先关注与香氛、家居生活、季节氛围、情绪体验和节日送礼相关的内容机会。
从调研结果中最多推荐 2 个与品牌、产品和目标用户高度相关的机会。每个推荐需提供可验证的信息来源和具体日期，说明事件背景、当前节点依据、为什么适合品牌参与，以及内容可以从什么用户场景或产品角度切入。
同时给出适合小红书的内容主题、标题方向、具体视觉创意和推荐内容形式。不预设固定视觉风格，根据事件本身、产品特点和目标用户选择最合适的内容与设计方向。
优先选择既有明确时间节点或热度依据，又能自然关联香氛、居家生活、季节氛围或送礼场景的机会。关联度较弱的热点不要强行参与，没有明确依据的内容不要描述为“热门”或“正在流行”。
日期尚未确认或信息存在不确定性的事件，可以作为备选机会，但需要明确标注当前的不确定性，不作为主要推荐。
若未来一周符合条件的机会不足 2 个，则按实际数量推荐并说明原因；若没有值得参与的机会，则如实说明，不强行生成选题，但仍需保留本周扫描结果和判断依据。
最后整理成一份调研报告，突出推荐结论、参考来源和可执行的内容方案。`},{id:"cn_social_topics",iconKey:"radar",recurrence:W("WE"),title:"社媒选题周报",description:"每周追踪热点趋势，推荐最多 3 个适合品牌跟进的社媒选题",prompt:`我负责一个狗狗宠物品牌的中国市场运营，主要通过小红书推广狗粮、零食、玩具和日常护理用品，目标用户是关注狗狗健康、日常陪伴和养宠体验的人群。
请调研过去 7 天中国市场与狗狗、养宠生活和宠物消费相关的热点趋势，优先关注近期具有明确讨论度、时效性或用户关注度的事件、话题和生活方式趋势。
从调研结果中选出本周最值得做的 3 个小红书内容选题，并按推荐优先级排序。每个选题需提供可验证的信息来源和日期，并说明：
当前热度或趋势依据
为什么适合品牌参与
可以从什么用户场景或产品角度切入
中文标题示例
具体视觉创意
推荐采用图文还是短视频
按北京时间建议的发布时间
优先选择既有近期热度，又能自然关联狗粮、零食、玩具、护理或养宠陪伴场景的话题。不预设固定视觉风格，根据热点特点、产品特点和目标用户提出最合适的内容与设计方向。
避免与上周已经使用过的选题重复。没有明确热度依据的内容，不要描述为“正在流行”“热门”或“爆火”。关联度较弱的话题不要为了追热点强行植入产品。
如果符合条件的选题不足 3 个，则按实际数量推荐并说明原因，不为了凑数降低选题质量。
最后整理成一份调研报告，突出推荐结论、参考来源和可执行的内容方案。`},{id:"cn_daily_poster",iconKey:"lightning",recurrence:$("09:00"),title:"每日小红书选题建议",description:"每天发现适合品牌跟进的内容机会，提供选题、文案和视觉建议",prompt:`我负责一个新中式茶饮品牌的中国市场运营，主要通过小红书分享茶饮日常、轻养生生活方式和新品种草内容，目标用户是 20-35 岁的都市女性。
请每天调研当天与茶饮、轻养生、节气、节日或季节变化相关的热点事件与内容机会，优先关注与中国用户生活方式、饮茶场景、女性轻养生和新中式审美相关的节点。
若存在与品牌和目标用户高度相关、且有明确依据的内容机会，则围绕最值得跟进的主题确定当日选题。需提供可验证的信息来源和日期，说明当前热点或节点依据、为什么适合品牌参与，以及内容可以从什么用户场景或产品角度切入。
同时给出适合小红书的内容主题、中文标题示例、推荐文案、具体视觉创意和推荐内容形式。不预设固定视觉风格，根据热点特点、产品特点和目标用户选择最合适的内容与设计方向。
优先选择既有明确时效性或节点依据，又能自然关联饮茶场景、产品特点、季节氛围或轻养生生活方式的话题。关联度较弱的热点不要强行参与，没有明确依据的内容不要描述为“热门”“正在流行”或“爆火”。
若当天没有值得参与的热点、节气、节日或季节性节点，则如实说明当天没有合适的内容机会，不强行生成选题，但仍需保留当天的扫描结果和判断依据。
最后整理成一份调研报告，突出推荐结论、参考来源和可执行的内容方案。`},{id:"cn_moodboard",iconKey:"light-bulb-glow",recurrence:W("TH"),title:"每周灵感情绪板",description:"每周探索 3 个不同的品牌视觉方向，各生成一张情绪板并提供应用建议",prompt:"我负责一个面向年轻消费者的生活方式品牌，希望持续探索新的视觉表达，在保持品牌辨识度的同时，让不同内容场景拥有更丰富的设计可能。请围绕品牌定位、产品特点和现有视觉资产搜索有启发性的视觉参考，提出 3 个差异明显的设计方向，并为每个方向生成一张 Moodboard（情绪板）放到画布中。每个方向需要说明更适合表达什么内容，例如新品发布、产品卖点、生活方式内容或 Campaign（品牌营销活动），同时给出配色、字体、图片风格、构图和排版建议，并说明可以具体应用在哪些设计中，以及为什么适合这个品牌。三个方向要像 3 套真正不同的 Creative Direction（创意方向），不要只是更换颜色或局部元素。探索时不预设具体风格倾向，优先寻找既符合品牌本身、又能带来新鲜感和实际落地价值的视觉方向。"},{id:"cn_drama_radar",iconKey:"cryptopunk",recurrence:W("MO"),title:"漫剧选题雷达",description:"每周追踪热门题材，推荐选题，并为主推选题生成首集脚本、角色场景设定和开场分镜",prompt:`每次执行时，生成未来一周的漫剧选题雷达，并为主推选题完成首集脚本、角色与场景设定、必要的道具设定及开场分镜，最终整理成一个可浏览页面。

我的账号定位：AI 漫剧 / 短剧内容账号，主要做高概念、强反转、连续追更型剧情视频。
主要内容方向：都市异能、重生逆袭、悬疑反转、规则怪谈、末日生存、无限流。
目标受众：18～35 岁，喜欢短剧、网文、动漫和爽文内容，偏好节奏快、设定强、冲突明确、每集结尾有追更钩子的内容。

每周收集最近 7 天与漫剧、短剧、网文改编、动漫剧情相关的热门内容，重点关注同类账号新发布作品、近期升温题材、爆款剧情设定、评论区高频讨论和用户催更方向。每个推荐需提供可验证的来源、发布日期和热度依据；缺乏依据时，不将内容描述为热门或正在升温。

与上一周期结果对比，优先识别本周新出现、明显升温或仍在持续发酵的内容机会，避免重复推荐没有新变化的旧题材。

先筛选 3～5 个未来一周最值得制作的漫剧选题。每个选题包含：
选题名称
核心设定
趋势依据
推荐原因
前 3 秒 Hook（开场钩子）
简要剧情方向

并按「优先做 / 可以跟 / 暂时观察」排序。

然后从中选择优先级最高的 1 个选题，完成首集制作准备材料：

第一集剧情脚本
包含开场冲突、核心事件、关键反转和结尾追更钩子。

角色定妆卡
展示主要角色的面部特征、发型妆容、不同头部角度、全身正侧背视图和完整服装造型，用于锁定角色形象一致性。

核心场景卡
展示场景平面布局、全景、中景、近景、鸟瞰视角、细节特写，以及色彩和材质参考，用于后续不同景别的分镜生成。

关键道具卡
如剧情存在重要道具，展示其材质、颜色、造型、尺寸，以及正面、侧面、背面、俯视等多角度视图，保证后续镜头中的道具一致性。

开场分镜卡
覆盖第一集前几个关键剧情段。每个镜头包含关键画面、景别 / 运镜、时长、人物动作、台词和语气，并保持人物、服装和场景连续一致，作为后续视频生成的直接参考。

最后将所有结果整理为一个可浏览的一页式漫剧企划页面，按以下顺序展示：

本周选题雷达 → 本周主推选题 → 第一集剧情 → 角色定妆卡 → 核心场景卡 → 关键道具卡 → 开场分镜卡 → 下一步建议

页面以视觉内容为主，文字保持简洁，重点突出本周为什么值得做这个题材，以及首集的角色、场景和开场表现。

如果本周没有值得推荐的选题，则仅输出扫描结果和判断依据，不强行制作首集材料；符合条件的选题不足 3 个时按实际数量推荐。如果某些外部内容无法访问，明确标注。`},{id:"cn_listing",iconKey:"cloth",recurrence:F,title:"上新出图流水线",description:"根据新品素材，按款生成电商主图、副图和场景图",prompt:"对我添加到任务里的这批产品图，每款生成一套电商上架图：白底主图 1 张（800x800）+ 副图 3 张（角度 / 细节特写）+ 场景图 1 张，按款依次生成，文件名标注款号和图位。缺角度的款注明「建议补拍」，不要硬生成。"},{id:"cn_rednote_cover",iconKey:"image",recurrence:F,title:"小红书封面赶工",description:"根据选题和品牌素材，生成 3 张小红书封面备选",prompt:"围绕「秋季新品·桂花轻乳茶上市」这个选题，用我添加到任务里的品牌素材，生成 3 张小红书封面备选（3:4 竖版），各附一条 20 字内高点击率口语化标题，标注推荐序。"},{id:"cn_sale_assets",iconKey:"rocket",recurrence:F,title:"大促借势物料",description:"结合品牌标识和主色，生成 2 张不同尺寸的大促氛围图",prompt:"用我添加的品牌 logo 和主色，生成 双11 氛围图 2 张（1:1 与 3:4），价格和文字留占位框方便我填。"},{id:"cn_upscale",iconKey:"brightness",recurrence:F,title:"批量高清放大",description:"将添加的图片批量高清放大到 4K，保持原比例",prompt:"把我添加到任务里的这批图全部高清放大到 4K，保持原比例与细节，按添加顺序依次输出，文件名沿用原图名。"},{id:"cn_localize",iconKey:"earth",recurrence:F,title:"多语言套图本地化",description:"将海报翻译成 4 种语言，保留原有画面",prompt:"把我添加的这张海报翻译成英语、日语、韩语、繁体中文各一张，画面保持不变、只改文字，每张文件名标注语言。"},{id:"cn_storyboard",iconKey:"video",recurrence:F,title:"短剧分镜批量出图",description:"按剧本批量生成分镜图，保持人物设定一致",prompt:"按我添加的剧本从第 6 节做到第 10 节，每节按固定 5 格分镜出图，人物设定沿用我添加的角色设定图，按节顺序生成、每张标注节号。"},{id:"cn_character",iconKey:"character",recurrence:F,title:"IP 角色批量出图",description:"按主题批量生成角色表情包和日常场景图",prompt:"用我添加到任务里的角色设定图，按「早安问候、深夜加班、周末躺平」三个主题各出 2 张角色图（表情包 / 日常场景），保持角色特征一致，每张标注主题。"},{id:"cn_reference",iconKey:"surfing",recurrence:F,title:"灵感参考收集",description:"搜集视觉参考，按方向分组拼版并附参考理由",prompt:"围绕「奶油风小户型家居布置」这个方向，联网搜集 15-20 张高质量参考图，按风格 / 配色 / 构图分组，每组合成一张拼版参考图，图上标注分组名和一句参考理由。找不到足够数量时如实注明，不凑数。"}],J=[{id:"inspiration_radar",cover:"schedule.emptyInspiration"},{id:"competitor_research",cover:"schedule.emptyCompetitor"},{id:"occasion_prep",cover:"schedule.emptyOccasion"}];function X(e,t=new Date){let{frequency:l,weekday:n,time:a}=e.recurrence;if("weekly"===l)return{frequency:l,time:a,weekdays:[n??(0,q.todayWeekday)(t)]};if("daily"===l)return{frequency:l,time:a,weekdays:[(0,q.todayWeekday)(t)]};let r=new Date(t.getTi